APP_ENV=development
API_ADDR=:8080
API_INTERNAL_ADDR=127.0.0.1:8081
BASE_DOMAIN=localhost
APP_NAME=Undangin
# Portal customer (link Daftar/Masuk dari landing page)
PORTAL_URL=http://localhost:5173
# Domain sendiri: customer arahkan CNAME ke target ini (atau A record ke IP server)
CUSTOM_DOMAIN_CNAME=custom.localhost
CUSTOM_DOMAIN_IPS=
PUBLIC_URL_PATTERN=http://{sub}.localhost:8080

# Buat database dulu: CREATE DATABASE undangan;
DATABASE_URL=postgres://postgres:PASSWORD@127.0.0.1:5432/undangan?sslmode=disable

# Wajib di production, minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

THEMES_DIR=themes
# Hasil `npm run build` yang dilayani di admin.<BASE_DOMAIN> & app.<BASE_DOMAIN>
ADMIN_DIST=../frontend/apps/admin/dist
PORTAL_DIST=../frontend/apps/portal/dist

# Object storage: local (folder di bawah) atau s3 (R2 / AWS S3 / MinIO / IDCloudHost / Biznet NEO)
STORAGE_DRIVER=local
UPLOAD_DIR=storage/uploads
PRIVATE_DIR=storage/private
# Contoh Cloudflare R2: S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PATH_STYLE=false
# Opsional: URL CDN/bucket publik (akar bucket). Kosong = file publik diproksikan lewat /uploads/.
S3_PUBLIC_BASE_URL=

# Super admin pertama dibuat otomatis saat startup bila email belum ada
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ---- Notifikasi Telegram (opsional) ----
# Buat bot lewat @BotFather → dapat token. Chat ID: kirim /start ke bot Anda, bot membalas ID-nya.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Webhook (production): isi keduanya. Kosongkan TELEGRAM_WEBHOOK_URL saat dev → bot memakai polling.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Portal admin (tautan di pesan Telegram)
ADMIN_URL=http://localhost:5174

# Landing page (template Go)
LANDING_DIR=web/landing

# ---- Khusus deploy/docker-compose.yml ----
POSTGRES_PASSWORD=
ACME_EMAIL=admin@example.com
# Token Cloudflare (DNS edit) untuk wildcard SSL *.BASE_DOMAIN
CF_API_TOKEN=

# ---- Contoh nilai production (VPS) — panduan lengkap: docs/DEPLOY.md ----
# APP_ENV=production
# BASE_DOMAIN=undangin.id
# PUBLIC_URL_PATTERN=https://{sub}.undangin.id
# PORTAL_URL=https://app.undangin.id
# CUSTOM_DOMAIN_CNAME=custom.undangin.id
# CUSTOM_DOMAIN_IPS=<IP VPS>
# DATABASE_URL=postgres://undangan:<POSTGRES_PASSWORD>@db:5432/undangan?sslmode=disable
